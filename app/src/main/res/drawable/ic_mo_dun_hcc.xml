        android:pathData="M34,22 L64,22 L78,36 L78,86 L34,86 Z" />
    <!-- nếp gấp -->
    <path
        android:fillColor="#F0C9BE"
        android:pathData="M64,22 L78,36 L64,36 Z" />

    <!-- ba dòng chữ -->
    <path
        android:fillColor="#C13F28"
        android:pathData="M43,48 L69,48 L69,53 L43,53 Z" />
    <path
        android:fillColor="#C13F28"
